# --- Supabase (accounts, profiles, KYC, project applications & documents)
# Dashboard → Project Settings → API Keys
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
# Server-only: used to link wallets and by `npm run create-user`. Never expose to the browser.
SUPABASE_SECRET_KEY=sb_secret_...

# --- Chain (balances, trades, retirements, certificates)
# Local Hardhat node (this project runs it on 8546; match whatever `npx hardhat node --port` you use)
NEXT_PUBLIC_LOCAL_RPC_URL=http://127.0.0.1:8546

# Labchain — leave blank to hide the network
NEXT_PUBLIC_LABCHAIN_RPC_URL=
NEXT_PUBLIC_LABCHAIN_CHAIN_ID=
NEXT_PUBLIC_LABCHAIN_EXPLORER_URL=

# Only needed for WalletConnect (mobile) wallets; MetaMask in the browser works without it
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=
